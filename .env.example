# ============================================
# QALCUITY APP - Environment Configuration
# ============================================
# App-specific environment variables.
# Main configuration is in the root .env file.
#
# This file is for app-level overrides only.
# Copy to .env in the qalcuity/ directory if needed.
# NEVER commit .env to version control.
# ============================================

# --------------------------------------------
# App Metadata
# --------------------------------------------
QALCUITY_APP_NAME=qalcuity
QALCUITY_VERSION=0.0.1

# --------------------------------------------
# Settings API
# --------------------------------------------
# get_settings() mengembalikan dict dari Qalcuity Settings DocType
# Cache policy: di-clear saat settings di-update

# --------------------------------------------
# Scheduler
# --------------------------------------------
# Daily task: check_subscription_expiry
# Runs via Frappe scheduler (hooks.py → scheduler_events)

# --------------------------------------------
# Patches
# --------------------------------------------
# Patches dijalankan via `bench migrate`
# Current patches:
#   - add_tenant_to_subscription (2026-08-24)
#     Menambahkan field tenant (Link) ke Qalcuity Subscription
#   - seed_bank_accounts (2026-08-24)
#     Seed 4 bank accounts (BRI, JAGO, BTN, BSI) ke Qalcuity Settings
# Lihat: qalcuity/patches.txt
